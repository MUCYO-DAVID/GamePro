# --- Supabase Postgres (project jqfgdicjuxjvhhpbbaew) ---
# Get these from Supabase dashboard -> Connect (top bar) -> "ORMs" -> Prisma.
# App connection: transaction pooler, port 6543 (required for Vercel serverless)
# Special characters in the password must be URL-encoded (e.g. "@" -> %40).
DATABASE_URL="postgresql://postgres.jqfgdicjuxjvhhpbbaew:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations / scripts: session pooler, port 5432
DIRECT_URL="postgresql://postgres.jqfgdicjuxjvhhpbbaew:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# Only needed once, for `npm run copy-data` (old Railway database)
SOURCE_DATABASE_URL=""

PORT=3000
SESSION_SECRET="change-me-in-production"
REQUIRE_LOGIN_TO_BOOK="false"
# On Vercel set this to your site URL, e.g. https://gamepro.vercel.app (used in email links)
APP_BASE_URL="http://localhost:3000"

# SMTP (email) settings
# Example (Gmail): SMTP_HOST="smtp.gmail.com" SMTP_PORT="587" SMTP_SECURE="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="GamePro <no-reply@gamepro.local>"

# Admin account created by `npm run seed` (keep the real password only in .env)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Marketplace ──
# New listings need admin approval before they're public (set "false" to publish instantly)
MARKETPLACE_REQUIRE_APPROVAL="true"

# ── Advertising payments ──
PAYMENT_CURRENCY="RWF"
# Option A (works without a payment provider): Mobile Money transfer, verified by an admin.
# Leave empty to hide this option.
MANUAL_PAYMENT_INSTRUCTIONS=""
# Option B: Flutterwave hosted checkout (MTN/Airtel Mobile Money Rwanda + cards).
# Secret key from Flutterwave dashboard → Settings → API keys. Never put it in frontend code.
FLW_SECRET_KEY=""
# Any long random string; paste the same value in Flutterwave → Settings → Webhooks ("Secret hash").
# Webhook URL: https://<your-site>/api/payments/flutterwave/webhook
FLW_SECRET_HASH=""
FLW_PAYMENT_OPTIONS="mobilemoneyrwanda,card"
# Shown to advertisers (form + decline email)
AD_REFUND_POLICY=""

# ── Scheduled job (Vercel Cron calls /api/cron/daily with this as a Bearer token) ──
CRON_SECRET=""

# ── Image storage (optional) ──
# Without these, uploaded photos are stored in the database. With them, in Supabase Storage (recommended
# once there are many listings). Service role key: Supabase → Project Settings → API. Server-side only.
SUPABASE_URL="https://jqfgdicjuxjvhhpbbaew.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="gamepro-uploads"
