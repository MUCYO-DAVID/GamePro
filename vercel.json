{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/views/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/admin", "destination": "/api" },
    { "source": "/admin.html", "destination": "/api" },
    { "source": "/health", "destination": "/api" },

    { "source": "/games", "destination": "/games.html" },
    { "source": "/booking", "destination": "/booking.html" },
    { "source": "/signup", "destination": "/signup.html" },
    { "source": "/signin", "destination": "/signin.html" },
    { "source": "/2fa", "destination": "/twofa.html" },
    { "source": "/forgot-password", "destination": "/forgot-password.html" },
    { "source": "/reset-password", "destination": "/reset-password.html" }
  ]
}
